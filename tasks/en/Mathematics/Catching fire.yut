14e5a29d"}]},{"id":"0,1180,7","type":3,"elements":[{"id":"0,1180,7,0","type":4,"elements":"and realize","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1181","type":2,"elements":[{"id":"0,1181,0","type":3,"elements":[{"id":"0,1181,0,0","type":4,"elements":"we're only a few paces from the force field. There's the telltale square, high up and to my right, just as it was ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,1","type":3,"elements":[{"id":"0,1181,1,0","type":4,"elements":"this morning. What did Beetee do? Did he actually try to drive the knife into the force field the way Peeta did by ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,2","type":3,"elements":[{"id":"0,1181,2,0","type":4,"elements":"accident? And what's the deal with the wire? Was this his backup plan? If electrifying the water failed, did he ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,3","type":3,"elements":[{"id":"0,1181,3,0","type":4,"elements":"mean to send the lightning bolt's energy into the force field? What would that do, anyway? Nothing? A great ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,4","type":3,"elements":[{"id":"0,1181,4,0","type":4,"elements":"deal? Fry us all? The force field must mostly be energy, too, I guess. The one in the Training Center was ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,5","type":3,"elements":[{"id":"0,1181,5,0","type":4,"elements":"invisible. This one seems to somehow mirror the jungle. But I've seen it falter when Peeta's knife struck it and ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,6","type":3,"elements":[{"id":"0,1181,6,0","type":4,"elements":"when my arrows hit. The real world lies right behind it. My ears are not ringing. It was the insects after all. I know ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,7","type":3,"elements":[{"id":"0,1181,7,0","type":4,"elements":"that now because they are dying out quickly and I hear nothing but the jungle sounds. Beetee is useless. I ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1181,8","type":3,"elements":[{"id":"0,1181,8,0","type":4,"elements":"can't rouse him. I can't save him. I don't know what he was trying","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1182","type":2,"elements":[{"id":"0,1182,0","type":3,"elements":[{"id":"0,1182,0,0","type":4,"elements":"","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1183","type":2,"elements":[{"id":"0,1183,0","type":3,"elements":[{"id":"0,1183,0,0","type":4,"elements":"to do with the knife and the wire and he's incapable of explaining. The moss bandage on my arm is soaked ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,1","type":3,"elements":[{"id":"0,1183,1,0","type":4,"elements":"and there's no use fooling myself. I'm so light-headed I'll black out in a matter of minutes. I've got to get away ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,2","type":3,"elements":[{"id":"0,1183,2,0","type":4,"elements":"from this tree and-- \"Katniss!\" I hear his voice though he's a far distance away. But what is he doing? Peeta ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,3","type":3,"elements":[{"id":"0,1183,3,0","type":4,"elements":"must have figured out that everyone is hunting us by now. \"Katniss!\" I can't protect him. I can't move fast or far ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,4","type":3,"elements":[{"id":"0,1183,4,0","type":4,"elements":"and my shooting abilities are questionable at best. I do the one thing I can to draw the attackers away from him ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,5","type":3,"elements":[{"id":"0,1183,5,0","type":4,"elements":"and over to me. \"Peeta!\" I scream out. \"Peeta! I'm here! Peeta!\" Yes, I will draw them in, any in my vicinity, away ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,6","type":3,"elements":[{"id":"0,1183,6,0","type":4,"elements":"from Peeta and over to me and the lightning tree that will soon be a weapon in and of itself. \"I'm here! I'm here!\" ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,7","type":3,"elements":[{"id":"0,1183,7,0","type":4,"elements":"He won't make it. Not with that leg in the night. He will never make it in time. \"Peeta!\" It's working. I can hear ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1183,8","type":3,"elements":[{"id":"0,1183,8,0","type":4,"elements":"them coming. Two of them. Crashing through the","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1184","type":2,"elements":[{"id":"0,1184,0","type":3,"elements":[{"id":"0,1184,0,0","type":4,"elements":"jungle. My knees start to give out and I sink down next to Beetee, resting my weight on my heels. My bow and ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1184,1","type":3,"elements":[{"id":"0,1184,1,0","type":4,"elements":"arrow lift into position. If I can take them out, will Peeta survive the rest? Enobaria and Finnick reach the ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,1184,2","type":3,"elements":[{"id":"0,1184,2,0","type":4,"elements":"lightning tree. They can't see me, sitting above them on","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1185","type":2,"elements":[{"id":"0,1185,0","type":3,"elements":[{"id":"0,1185,0,0","type":4,"elements":"","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,1186","type":2,"elements":[{"id":"0,1186,0","type":3,"elements":[{"id":"0,1186,0,0","type":4,"elements":"the slope, my skin camouflaged in ointment. I home in on Enobaria's neck. With any luck, when I kill