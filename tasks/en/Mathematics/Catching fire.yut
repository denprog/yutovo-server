6,1,0","type":4,"elements":"are about to settle down when I see them. Three figures, about two spokes away, stumbling onto the beach. ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,996,2","type":3,"elements":[{"id":"0,996,2,0","type":4,"elements":"\"There,\" I say quietly, nodding in the newcomers' direction. Peeta and Finnick follow my gaze. As if by previous ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,996,3","type":3,"elements":[{"id":"0,996,3,0","type":4,"elements":"agreement, we all fade back into the shadows of the jungle. The trio's in bad shape--you can see that right off. ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,996,4","type":3,"elements":[{"id":"0,996,4,0","type":4,"elements":"One is being practically dragged out by a second, and the third","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,997","type":2,"elements":[{"id":"0,997,0","type":3,"elements":[{"id":"0,997,0,0","type":4,"elements":"","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]}],"format_name":"Text body"},{"id":"0,998","type":2,"elements":[{"id":"0,998,0","type":3,"elements":[{"id":"0,998,0,0","type":4,"elements":"wanders in loopy circles, as if deranged. They're a solid brick-red color, as if they've been dipped in paint and ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,998,1","type":3,"elements":[{"id":"0,998,1,0","type":4,"elements":"left out to dry. \"Who is that?\" asks Peeta. \"Or what? Muttations?\" I draw back an arrow, readying for an attack. ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,998,2","type":3,"elements":[{"id":"0,998,2,0","type":4,"elements":"But all that happens is that the one who was being dragged collapses on the beach. The dragger stamps the ","format_id":"93e3f29c-098d-4872-9ef8-405c14e5a29d"}]},{"id":"0,998,3","type":3,"elements":[{"id":"0,998,3,0","type":4,"elements":"ground in frustration and,","format_id":"93e3f29c-098d-4