[Unit]
Description=Yutovo server
DefaultDependencies=no
After=network.target

[Service]
WorkingDirectory=/opt/yutovo
EnvironmentFile=/opt/yutovo/yutovo-server.env
Environment="YUTOVO_DEPLOY=/opt/yutovo"
ExecStart=/opt/yutovo/yutovo-server -d /opt/yutovo/spa/
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target