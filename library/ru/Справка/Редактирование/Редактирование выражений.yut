            {
                "id": "0,29",
                "type": 2,
                "elements": [
                    {
                        "id": "0,29,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,29,0,0",
                                "type": 4,
                                "elements": "Удаление символов и операций",
                                "format_id": "ced65111-c3e9-4c8c-8684-b01533cc2d29"
                            }
                        ]
                    }
                ],
                "format_name": "Header 4",
