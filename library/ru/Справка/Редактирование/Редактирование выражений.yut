                                                "type": 7,
                                                "elements": [
                                                    {
                                                        "id": "0,3,0,0,0,0,0",
                                                        "type": 8,
                                                        "elements": "",
                                                        "format_id": "e254f8da-75d2-4960-80da-53bae4501b8b",
                                                        "can_merge": true
                                                    }
                                                ]
                                            }
                                        ],
                                        "format_name": "Code",
