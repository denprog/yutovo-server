            {
                "id": "0,42",
                "type": 2,
                "elements": [
                    {
                        "id": "0,42,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,42,0,0",
                                "type": 4,
                                "elements": "Таким образом можно удалить все возможные в программе символы операций.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
