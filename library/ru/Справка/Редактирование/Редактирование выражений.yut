                "elements": [
                    {
                        "id": "0,15,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,15,0,0",
                                "type": 4,
                                "elements": "Помимо введенного ранее числа появился новый символ пустой строки, на который теперь указывает курсор. Это ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,15,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,15,1,0",
                                "type": 4,
                                "elements": "означает, что можно ввести нужное значение степени. Введите \"2\".",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
