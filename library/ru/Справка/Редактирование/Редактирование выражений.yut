            {
                "id": "0,50",
                "type": 2,
                "elements": [
                    {
                        "id": "0,50,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,50,0,0",
                                "type": 4,
                                "elements": "Строки \"sin\" и \"cos\" отобразились другим цветом, нежели числа. Это сделано для удобства.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,51",
                "type": 2,
                "elements": [
                    {
                        "id": "0,51,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,0,0",
                                "type": 4,
                                "elements": "Теперь извлечем квадратный корень из выражения в знаменателе. Здесь опять поможет выделение. Сейчас курсор ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,51,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,1,0",
                                "type": 4,
                                "elements": "стоит в крайнем правом положении, значит, чтобы выделить знаменатель, нужно нажимать [Shift+Left] до полного ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,51,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,2,0",
                                "type": 4,
                                "elements": "выделения этого выражения, либо [Shift+Home] чтобы выделить всю строку. Затем введите операцию извлечения ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,51,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,3,0",
                                "type": 4,
                                "elements": "корня нажав [Shift+Ctrl+Q].",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
