            {
                "id": "0,60",
                "type": 2,
                "elements": [
                    {
                        "id": "0,60,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,0,0",
                                "type": 4,
                                "elements": "Итак, курсор находится в новой формуле, пока что представленной только пустой строкой. Переместите курсор на ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
                    },
                    {
                        "id": "0,60,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,1,0",
                                "type": 4,
                                "elements": "верхнюю формулу и выделите операцию степени. Для этого надо поставить курсор (клавишами или мышью) перед ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
                    },
                    {
                        "id": "0,60,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,2,0",
                                "type": 4,
                                "elements": "всей операцией возведения в степень и нажать [Shift+Right]. Затем скопируйте выделенное выражение в буфер, ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
                    },
                    {
                        "id": "0,60,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,3,0",
                                "type": 4,
                                "elements": "нажав [Ctrl+Ins], либо кнопку на панели инструментов. Затем переместите курсор на нижнюю формулу и вставьте ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
                    },
                    {
                        "id": "0,60,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,4,0",
                                "type": 4,
                                "elements": "туда скопированное выражение, нажав [Shift+Ins] или кнопку вставки на панели. Получается:",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
