            },
            {
                "id": "0,43",
                "type": 2,
                "elements": [
                    {
                        "id": "0,43,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,43,0,0",
                                "type": 4,
                                "elements": "Ввод операций с использованием выделения",
                                "format_id": "fbf0ad7f-2a3f-4347-be39-be03e2867e74"
                            }
                        ]
                    }
                ],
                "format_name": "Header 4",
                "format_alignment": 0
            },
            {
                "id": "0,44",
                "type": 2,
                "elements": [
                    {
                        "id": "0,44,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,44,0,0",
                                "type": 4,
                                "elements": "Параметры операций могут использовать выражение, содержащее другие операции. Для ввода таких операций ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,44,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,44,1,0",
                                "type": 4,
                                "elements": "удобно использовать выделение частей формулы.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,45",
                "type": 2,
                "elements": [
                    {
                        "id": "0,45,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,45,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "4af04db8-ce10-46a1-838b-0c69dac0f1c7"
                            }
                        ]
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,46",
                "type": 2,
                "elements": [
                    {
                        "id": "0,46,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,0,0",
                                "type": 4,
                                "elements": "Возьмем выражение из предыдущего примера и разделим его на число. Для этого в начале выделим его мышью или ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,46,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,1,0",
                                "type": 4,
                                "elements": "курсорными клавишами. Выделение курсорными клавишами осуществляется последовательным нажатием ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,46,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,2,0",
                                "type": 4,
                                "elements": "[Shift+Up] или [Shift+Down] до тех пор пока все выражение не будет выделено. Затем нажмите \"/\" для ввода операции ",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    },
                    {
                        "id": "0,46,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,46,3,0",
                                "type": 4,
                                "elements": "деления.",
                                "format_id": "57e9f3c8-a579-4354-861c-c9020e952d3a"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
