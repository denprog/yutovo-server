                            {
                                "id": "0,68,0,0",
                                "type": 4,
                                "elements": "Редактор поддерживает отмену - повтор операций. Это значит, что при неправильном вводе можно отменить ",
                                "format_id": "f8c88080-0224-4348-9177-a155ce70ee76"
                            }
                        ]
