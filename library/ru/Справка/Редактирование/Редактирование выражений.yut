            {
                "id": "0,34",
                "type": 2,
                "elements": [
                    {
                        "id": "0,34,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,34,0,0",
                                "type": 4,
                                "elements": "Ранее введенную операцию можно удалить. Удаление операции означает удаление только символа операции с ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,34,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,34,1,0",
                                "type": 4,
                                "elements": "оставлением ее параметров. Это действие производится нажатием [Del] когда курсор находится в позиции \"перед ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,34,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,34,2,0",
                                "type": 4,
                                "elements": "операцией\".",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
