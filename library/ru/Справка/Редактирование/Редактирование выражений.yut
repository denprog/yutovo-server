            {
                "id": "0,12",
                "type": 2,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "elements": "Нажатие клавиши [End] приведет к новому положению курсора - \"после последнего символа\".",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,13",
                "type": 2,
