            {
                "id": "0,38",
                "type": 2,
                "elements": [
                    {
                        "id": "0,38,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,0,0",
                                "type": 4,
                                "elements": "Как видим, параметры - степень корня и подкоренное выражение остались, удалился только сам корень. ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,38,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,1,0",
                                "type": 4,
                                "elements": "Аналогичным образом можно удалить символ деления. Из прошлой позиции нажмите [Up], чтобы передвинуть ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,38,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,38,2,0",
                                "type": 4,
                                "elements": "курсор на позицию перед символом деления и удалите его:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
