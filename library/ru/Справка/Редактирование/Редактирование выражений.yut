                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Курсорные клавиши позволяют перемещаться по формулам. Курсор влево и вправо (клавиши [Стрелка влево] и ",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    },
                    {
                        "id": "0,4,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,1,0",
                                "type": 4,
                                "elements": "[Стрелка вправо]) движется последовательно с формулы на формулу. При движении вверх ([Стрелка вверх]) и вниз ",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    },
                    {
                        "id": "0,4,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,2,0",
                                "type": 4,
                                "elements": "([Стрелка вниз]) курсор переходит на ближайшую верхнюю или нижнюю ветвь. Клавишами [Ctrl]-[Стрелка влево] и ",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    },
                    {
                        "id": "0,4,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,3,0",
                                "type": 4,
                                "elements": "[Ctrl]-[Стрелка вправо] можно двигать курсор не входя во вложенные элементы. Клавиша [Home] служит для ",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    },
                    {
                        "id": "0,4,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,4,0",
                                "type": 4,
                                "elements": "перехода курсора к более общей ветви, либо в начало строки.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "024d1211-a16d-4e49-9548-1753392575aa"
                            }
                        ]
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "В следующем примере будет введено выражение с самого начала, с пустой строки.",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Вводите число: \"1234.5678\".",
                                "format_id": "d90ae9fb-0037-403e-ae1f-247ec229fb86"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 5,
                                "elements": [
