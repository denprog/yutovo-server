            },
            {
                "id": "0,30",
                "type": 2,
                "elements": [
                    {
                        "id": "0,30,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "elements": "Символы в строке удаляются просто, как принято это в редакторах. Нужно подвести курсор к нужному символу и ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,30,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,30,1,0",
                                "type": 4,
                                "elements": "нажать [Del], если символ находится справа, или [Backspace], если символ слева.",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,31",
                "type": 2,
                "elements": [
                    {
                        "id": "0,31,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,31,0,0",
                                "type": 4,
                                "elements": "Пример:",
