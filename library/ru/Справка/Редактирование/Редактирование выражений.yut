            {
                "id": "0,17",
                "type": 2,
                "elements": [
                    {
                        "id": "0,17,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,0,0",
                                "type": 4,
                                "elements": "Теперь к полученному выражению требуется прибавить другое. Для этого необходимо поставить курсор после ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,17,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,1,0",
                                "type": 4,
                                "elements": "символа возведения в степень. Нажмите: [Right]. Курсор встанет после введенной операции и укажет положение, ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,17,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,2,0",
                                "type": 4,
                                "elements": "где появится новая операция или строка. Это будет сложение. Вводите: \"+\".",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
