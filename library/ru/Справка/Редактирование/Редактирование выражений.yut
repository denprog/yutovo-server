                            }
                        ]
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,32",
                "type": 2,
                "elements": [
                    {
                        "id": "0,32,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,32,0,0",
                                "type": 4,
                                "elements": "В начатом выше пример удалим последний символ подкоренного выражения. Для этого курсорными клавишами или ",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    },
                    {
                        "id": "0,32,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,32,1,0",
                                "type": 4,
                                "elements": "мышью поставьте курсор на конец подкоренного выражения и нажмите [Del]:",
                                "format_id": "f47c43eb-9509-4be3-b364-17fa89034f4d"
                            }
                        ]
                    }
                ],
