            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Целые числа не имеют дробной части. Они могут быть двоичной, десятичной, восьмеричной, либо ",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "шестнадцатеричной нотации. Над ними можно производить логические операции.",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,12",
                "type": 2,
                "elements": [
                    {
                        "id": "0,12,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "elements": "Присвоение нотации числу осуществляется операцией (клавиша \"#\"), либо выбором в математической панели.",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
