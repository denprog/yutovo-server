            {
                "id": "0,17",
                "type": 2,
                "elements": [
                    {
                        "id": "0,17,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,0,0",
                                "type": 4,
                                "elements": "Дробные числа представлены обыкновенной дробью. Ввод их производится с использованием символа деления ",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    },
                    {
                        "id": "0,17,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,1,0",
                                "type": 4,
                                "elements": "(клавиша \"/\"), либо выбором этого символа в математической панели. Целую часть дроби, при ее наличии, можно ",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    },
                    {
                        "id": "0,17,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,17,2,0",
                                "type": 4,
                                "elements": "вводить слитно с самой дробью, как это показано в следующем примере, так и через символ сложения.",
                                "format_id": "eefebd6c-6f94-4f91-a429-95a7d74c5dde"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
