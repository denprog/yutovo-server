                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Предназначена для работы с файлами и для редактирования текста. Открытие, сохранение, скачивание, ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "переименовывание и удаление файлов доступно только после логина. Кнопка \"Настройки\" ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            },
                            {
                                "id": "0,2,1,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,1,2",
                                "type": 4,
                                "elements": " предназначена для ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,2,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,2,0",
                                "type": 4,
                                "elements": "установки параметров вычисления выражений и языка документа. От языка документа зависит набор используемых ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,2,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,3,0",
                                "type": 4,
                                "elements": "встроенных переменных, функций и размерностей. Кнопка \"Пересчитать документ\" ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            },
                            {
                                "id": "0,2,3,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,3,2",
                                "type": 4,
                                "elements": " вызывает вычисление всех ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
                        "id": "0,2,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,4,0",
                                "type": 4,
                                "elements": "выражений в документе. Кнопки выбора формата параграфа, шрифта, его размера и стиля эквивалентны обычному ",
                                "format_id": "3333989f-b08b-4668-a6b1-c7c3e75f3118"
                            }
                        ]
                    },
                    {
