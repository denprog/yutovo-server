    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Блок кода - это прямоугольник в тексте для проведения вычислений. Он появляется в начале пустого документа и ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "далее может быть добавлен в любом месте документа (кроме места внутри блока кода) с помощью кнопки \"Код\" ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            },
                            {
                                "id": "0,0,1,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": " или комбинацией клавиш [Ctrl+Shift+C]. Также блок кода появляется при начале ввода кода кнопками ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "математической панели, если курсор в этот момент не находится в коде.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Блоков кода может быть сколько угодно и между собой они образуют единое пространство кода. Это в частности ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "означает, что переменные и функции, объявленные в блоке выше могут быть использованы в блоке ниже.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Блоки кода можно копировать в буфер обмена как любые другие символы. Если математическое выражение из ",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "блока будет скопировано в текст, то автоматически возникнет блок кода.",
                                "format_id": "49520608-29db-4690-a828-188d80b6c2ab"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Текст вне блоков кода никак не влияет на вычисления.",
                                "format_id": "5695a9fc-bfb2-400e-9cf7-a97c96761c88"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            }
        ]
    },
    "caret": {
        "id": "0,0,0,0"
