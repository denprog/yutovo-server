    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Курсор редактора показывает позицию, где в данный момент будет ввод пользователя. От его положения зависит ",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "что может сделать пользователь для редактирования документа. Курсор может находиться в четырех основных ",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "положениях:",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• внутри строки, в этом случае он ничем не отличается от курсора обычного текстового редактора;",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• перед математической операцией, которая может состоять из одного символа (\"+\", \"-\"), либо составной (деление, ",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "корень);",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• после последней операции;",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• перед символом составной операции (у деления - горизонтальная черта, у возведения в степень - пустой ",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    },
