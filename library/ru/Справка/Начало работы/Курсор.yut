                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "В случае позиции \"перед операцией\" вставка будет производится до операции. Курсор выглядит как вертикальная ",
                                "format_id": "136734a7-3892-430d-986d-c27d227fbd30"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,1,0",
                                "type": 4,
                                "elements": "линия, находящаяся до операции и линия, подчеркивающая данную операцию.",
