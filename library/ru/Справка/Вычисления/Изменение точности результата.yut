    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Изменение точности результата возможно только для экспоненциальных и комплексных чисел. У целых и дробных ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "чисел нет плавающей точки.",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Сначала результат вычисляется с точностью по умолчанию, задаваемой в настройках документа. В дальнейшем ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "для каждого полученного результата точность можно изменить. Это делается с помощью клика правой кнопкой ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "мыши на результате и выбором \"Точность\". В появившемся диалоге нужно выбрать точность в пределах от 1 до 100 ",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    },
                    {
                        "id": "0,1,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,3,0",
                                "type": 4,
                                "elements": "и нажать OK. Выражение будет пересчитано с новой точностью.",
                                "format_id": "8fc5b17e-625d-4d0c-b231-6be959b5f53d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
