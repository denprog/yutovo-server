                        "elements": [
                            {
                                "id": "0,8,1,0",
                                "type": 4,
                                "elements": "переменную и функцию. То есть, при использовании в выражении, переменные и функции можно вводить через ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
