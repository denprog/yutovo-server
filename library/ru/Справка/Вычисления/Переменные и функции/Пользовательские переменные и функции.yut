                        "elements": [
                            {
                                "id": "0,8,2,0",
                                "type": 4,
                                "elements": "пробел от числа (а можно и слитно); такая запись (как принято) означает умножение числа на переменную или ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    },
