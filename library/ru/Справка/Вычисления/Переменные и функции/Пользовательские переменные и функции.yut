                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Ютово поддерживает пользовательские переменные и функции. Благодаря им, пользователь не ограничен ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "встроенными возможностями, а может расширять их.",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Любое пользовательское выражение (переменная, функция или размерность) должно быть объявлено до его ",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "первого использования.",
                                "format_id": "a2602d58-7d6a-4de2-b672-d7bca2938f23"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
