                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• При переопределении переменной или функции действует правило последовательности выражений в документе: ",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "в выражении используется то определение переменной или функции, которое сверху находится ближе других.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
