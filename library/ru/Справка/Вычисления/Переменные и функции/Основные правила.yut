                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "• Переменная или функция должны быть объявлены перед их первым использованием.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
