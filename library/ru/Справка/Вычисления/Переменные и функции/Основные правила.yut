                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Функция может иметь любое количество параметров, задаваемых через запятую.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ]
