                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Переменная или функция может быть определена более одного раза. Это называется переопределением.",
                                "format_id": "014955f8-2a77-4c58-857b-9e168ae64230"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
