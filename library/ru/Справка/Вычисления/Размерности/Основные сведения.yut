    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Ютово поддерживает размерности чисел и системы размерностей. Есть встроенные и пользовательские ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "размерности. Размерность определяется символом ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            },
                            {
                                "id": "0,0,1,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,1,2",
                                "type": 4,
                                "elements": " (клавиша \"~\"). Определение размерности должно ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "производиться до ее первого использования. Можно определять любые составные размерности, ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "присваивая им имена. В дальнейшем, если в вычисляемом выражении используются размерности, ",
                                "format_id": "41fb8729-e3da-41f3-b3ea-78a52b80cd02"
                            }
                        ]
                    },
                    {
                        "id": "0,0,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,4,0",
