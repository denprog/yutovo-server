    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Существует множество различных систем размерностей.",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "В данный момент встроены только 2 системы размерностей - СИ и русская. Метрическая система принята в ",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "программе по умолчанию. На ее размерностях строятся все остальные размерности, в том числе и других систем. ",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "В предыдущей главе было показано объявление пользовательских размерностей. Все те примеры относятся к ",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "метрической системе. Для объявления размерности другой системы нужно имя системы записывать явно в нижнем ",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    },
                    {
                        "id": "0,2,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,2,0",
                                "type": 4,
                                "elements": "индексе при объявлении размерности (клавиши [Ctrl+Shift+S] или кнопка ",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            },
                            {
                                "id": "0,2,2,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,2,2,2",
                                "type": 4,
                                "elements": "):",
                                "format_id": "d03b5dd4-ff09-4107-ad58-3a93d147fef2"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
