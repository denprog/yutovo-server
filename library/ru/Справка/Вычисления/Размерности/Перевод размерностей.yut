    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Ютово может переводить размерности из одной системы размерностей в другую, а также представлять результат в ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "других размерностях той же системы.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Перевод размерностей в пределах одной системы может происходить автоматически (если размерность не указана ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "явно) при вычислении результата выражения. Для перевода результата в другую систему необходимо ее явно ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "указывать.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Автоматический выбор размерности происходит когда результат выражения вычисляется впервые. Для выбора ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,2,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,1,0",
                                "type": 4,
                                "elements": "конкретной размерности и системы мер предназначено контексное меню результата вычислений. В этом меню ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,2,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,2,0",
                                "type": 4,
                                "elements": "пользователь выбирает нужную систему мер и размерность, в которую он хочет перевести результат.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Простые размерности",
                                "format_id": "fc9baea7-a714-4281-b68e-0cab40b2ef83"
                            }
                        ]
                    }
                ],
                "format_name": "Header 4",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Пример:",
                                "format_id": "fd15aa29-0e34-4511-92e9-eafcc0c796cd"
                            }
                        ]
                    }
                ],
                "format_name": "Example",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "В следующем примере используются размерности длины. Поскольку система мер не определена, используется ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,5,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,1,0",
                                "type": 4,
                                "elements": "определяемая по умолчанию метрическая система (СИ). При вычислениях происходит автоматический подбор ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,5,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,2,0",
                                "type": 4,
                                "elements": "наиболее подходящей размерности. Все используемые в примере размерности являются встроенными.",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
