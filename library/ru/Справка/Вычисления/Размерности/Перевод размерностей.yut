            {
                "id": "0,20",
                "type": 2,
                "elements": [
                    {
                        "id": "0,20,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,20,0,0",
                                "type": 4,
                                "elements": "Мера результата в этом случае - метры в секунду. Она получилась составной, поскольку меры, равной ей, не было ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,20,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,20,1,0",
                                "type": 4,
                                "elements": "объявлено. На основе такой размерности и исходя из встроенных мер, основанных на метрах и секундах, могут ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,20,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,20,2,0",
                                "type": 4,
                                "elements": "быть составлены различные сочетания, которые будут представлены в диалоге размерностей. Выберите, ",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    },
                    {
                        "id": "0,20,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,20,3,0",
                                "type": 4,
                                "elements": "например, \"см/с\".",
                                "format_id": "d067029d-76ed-4505-aa53-903ad4ee9dd6"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
