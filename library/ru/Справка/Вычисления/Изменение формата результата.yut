                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Первоначально для вычисления выражения используется автоподбор типа результата. Однако, для удобства ",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "представления вычисленный тип результата, стоящий после символа равенства, можно изменить. Для этого кликнув ",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "правой кнопкой мыши на результате, выберите в подменю \"Представить как\" нужный тип результата.",
                                "format_id": "bde05625-628f-4a77-bd87-cfe0843b9b5a"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
