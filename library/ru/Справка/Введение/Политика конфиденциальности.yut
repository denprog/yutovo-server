            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать личную информацию для ответа на запросы ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,1,0",
                                "type": 4,
                                "elements": "пользователей. Мы можем использовать личную информацию для ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,2,0",
                                "type": 4,
                                "elements": "улучшения услуг, веб-сайта и настольного приложения. Мы можем ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,3,0",
                                "type": 4,
                                "elements": "использовать личную информацию в целях безопасности для защиты ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,4,0",
                                "type": 4,
                                "elements": "пользователей и веб-сайта. Мы можем использовать информацию, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,5,0",
                                "type": 4,
                                "elements": "если это разрешено законом.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
