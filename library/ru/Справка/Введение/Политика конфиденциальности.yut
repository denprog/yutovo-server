                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать личную информацию пользователя, такую как имя, адрес электронной почты, IP-адрес и другую ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
