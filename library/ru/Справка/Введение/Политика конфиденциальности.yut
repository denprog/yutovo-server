                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать информацию для проверки вашей учетной ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
