                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "2. Способы сбора информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать информацию, когда пользователь регистрируется, отменяет регистрацию, входит или выходит ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "из системы на сайте.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Мы можем собирать личную информацию, когда пользователь использует любую из услуг сайта.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "3. Использование информации",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать информацию для проверки вашей учетной записи на веб-сайте, отправив письмо с ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "подтверждением на ваш зарегистрированный адрес электронной почты.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "Мы можем использовать личную информацию для ответа на запросы пользователей. Мы можем использовать ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,1,0",
                                "type": 4,
                                "elements": "личную информацию для улучшения услуг, веб-сайта и настольного приложения. Мы можем использовать личную ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,2,0",
                                "type": 4,
                                "elements": "информацию в целях безопасности для защиты пользователей и веб-сайта. Мы можем использовать информацию, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,7,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,3,0",
                                "type": 4,
                                "elements": "если это разрешено законом.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "4. Права пользователя на свои данные",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Вы можете потребовать, чтобы мы удалили любые личные данные, которые мы храним о вас. Сюда не входят ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "данные, которые мы обязаны хранить в административных, юридических целях или целях безопасности. Отправить ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,2,0",
                                "type": 4,
                                "elements": "запрос на удаление данных можно на сайте support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "5. Отказ от ответственности",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Вы принимаете на себя всю ответственность и риск в отношении использования вами веб-сайта, который ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "предоставляется «как есть» без каких-либо гарантий. Информация, доступ к которой осуществляется с помощью ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,2,0",
                                "type": 4,
                                "elements": "веб-сайта, включая, помимо прочего, весь контент и материалы, а также функции и услуги, представленные на ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,3,0",
                                "type": 4,
                                "elements": "нашем веб-сайте, все они представляются без каких-либо гарантий, включая, помимо прочего, гарантии ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,4,0",
                                "type": 4,
                                "elements": "относительно доступности, точности, полноты или полезности контента или информации, бесперебойности доступа ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,5",
                        "type": 3,
                        "elements": [
                            {
