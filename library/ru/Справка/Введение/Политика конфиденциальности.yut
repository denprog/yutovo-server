                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "4. Права пользователя на свои данные",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "Вы можете потребовать, чтобы мы удалили любые личные данные, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "которые мы храним о вас. Сюда не входят данные, которые мы ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,2,0",
                                "type": 4,
                                "elements": "обязаны хранить в административных, юридических целях или целях ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,3,0",
                                "type": 4,
                                "elements": "безопасности. Отправить запрос на удаление данных можно на сайте ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,9,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,4,0",
                                "type": 4,
                                "elements": "support@yutovo.ru.",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "5. Отказ от ответственности",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,11",
                "type": 2,
                "elements": [
                    {
                        "id": "0,11,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,0,0",
                                "type": 4,
                                "elements": "Вы принимаете на себя всю ответственность и риск в отношении ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,1,0",
                                "type": 4,
                                "elements": "использования вами веб-сайта, который предоставляется «как есть» ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,2,0",
                                "type": 4,
                                "elements": "без каких-либо гарантий. Информация, доступ к которой ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,3,0",
                                "type": 4,
                                "elements": "осуществляется с помощью веб-сайта, включая, помимо прочего, весь ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,4",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,4,0",
                                "type": 4,
                                "elements": "контент и материалы, а также функции и услуги, представленные на ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,5",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,5,0",
                                "type": 4,
                                "elements": "нашем веб-сайте, все они представляются без каких-либо гарантий, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,6",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,6,0",
                                "type": 4,
                                "elements": "включая, помимо прочего, гарантии относительно доступности, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,7",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,7,0",
                                "type": 4,
                                "elements": "точности, полноты или полезности контента или информации, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,8",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,8,0",
                                "type": 4,
                                "elements": "бесперебойности доступа и любые гарантии прав собственности, ",
                                "format_id": "d5a9ba87-de17-411b-a45a-36a44c60bcf3"
                            }
                        ]
                    },
                    {
                        "id": "0,11,9",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,11,9,0",
