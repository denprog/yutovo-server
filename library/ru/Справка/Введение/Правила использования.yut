    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Сервис yutovo.ru, yutovo.com (далее - Ютово) и приложение для ПК не предоставляют никаких гарантий, явных или ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "подразумеваемых, какого-либо назначения.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Провайдер сервиса Ютово и десктопного приложения не несет никакой ответственности, финансовой или иной, за ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,1,0",
                                "type": 4,
                                "elements": "любой причиненный ущерб или убытки от использования сервиса Ютово или десктопного приложения, включая, ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,1,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,2,0",
                                "type": 4,
                                "elements": "помимо прочего, причинение ущерба аппаратному и программному обеспечению Пользователя.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Документы, сохраненные в учетной записи Ютово, являются личными для зарегистрированных пользователей.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "Провайдер сервиса Ютово оставляет за собой право использовать все загруженные документы, логи программы, ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,1,0",
                                "type": 4,
                                "elements": "результаты расчетов, и входные данные внутри сервиса Ютово, в целях поддержки, развития и тестирования ",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    },
                    {
                        "id": "0,3,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,2,0",
                                "type": 4,
                                "elements": "сервиса Ютово.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "Провайдер сервиса Ютово оставляет за собой право изменять настоящие Условия использования в любое время.",
                                "format_id": "dc9ffcb7-ab56-417c-b9d1-fe0106cfa4d3"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
