                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• Поддерживаются пользовательские ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,6,0,1",
