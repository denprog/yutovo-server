    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Ютово - это приложение для решения различных математических задач. Ютово имеет наглядный \"бумажный\" вид ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "для вычислений. Оно использует общепризнанный математический синтаксис для отображения формул. Ютово ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    },
                    {
                        "id": "0,0,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,2,0",
                                "type": 4,
                                "elements": "предназначено для решения повседневных и инженерных задач и может быть использовано различными людьми и ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    },
                    {
                        "id": "0,0,3",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,3,0",
                                "type": 4,
                                "elements": "для различных работ.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Ютово использует графическое предствление математических формул.",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Результаты вычислений могут иметь любое количество цифр и ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "elements": "точность",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Изменение точности результата.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "elements": ".",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Ютово работает со следующими типами чисел: ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "elements": "вещественные",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Числа/Вещественные числа.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,3",
                                "type": 39,
                                "elements": "целые",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Числа/Целые числа.yut"
                            },
                            {
                                "id": "0,3,0,4",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,5",
                                "type": 39,
                                "elements": "дробные",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Числа/Дробные числа.yut"
                            },
                            {
                                "id": "0,3,0,6",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            },
                            {
                                "id": "0,3,0,7",
                                "type": 39,
                                "elements": "комплексные",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Вычисления/Числа/Комплексные числа.yut"
                            },
                            {
                                "id": "0,3,0,8",
                                "type": 4,
                                "elements": ".",
                                "format_id": "3e4a8e44-74f8-4c15-ac0b-e8d3a2f8bf9d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
