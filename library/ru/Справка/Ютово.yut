                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "Этот сервис объединяет текстовый редактор с встроенным в нем удобным калькулятором с графическим (как на ",
                                "format_id": "02546dfa-a44e-4781-8924-23b0f7a49fb0"
