    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo is an application for solving various mathematical problems. Yutovo has a visual \"paper\" view for calculations. It uses a generally accepted mathematical syntax to display formulas. Yutovo is ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "designed to solve everyday and engineering problems and can be used by different people and for different jobs.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• Yutovo uses a graphical representation of mathematical formulas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Calculation results can have any number of digits and ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,2,0,1",
                                "type": 39,
                                "elements": "accuracy",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Result precision adjustment.yut"
                            },
                            {
                                "id": "0,2,0,2",
                                "type": 4,
                                "elements": ".",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• Yutovo works with the following types of numbers: ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,1",
                                "type": 39,
                                "elements": "real",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Numbers/Real numbers.yut"
                            },
                            {
                                "id": "0,3,0,2",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,3",
                                "type": 39,
                                "elements": "integer",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Numbers/Integer numbers.yut"
                            },
                            {
                                "id": "0,3,0,4",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,5",
                                "type": 39,
                                "elements": "fractional",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Numbers/Rational numbers.yut"
                            },
                            {
                                "id": "0,3,0,6",
                                "type": 4,
                                "elements": ", ",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            },
                            {
                                "id": "0,3,0,7",
                                "type": 39,
                                "elements": "complex",
                                "format_id": "c2b4bd97-3c13-4720-8d04-be7c0766fd5d",
                                "url": "../Calculations/Numbers/Complex numbers.yut"
                            },
                            {
                                "id": "0,3,0,8",
                                "type": 4,
                                "elements": ".",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• The measure of an angle can be changed.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• Commonly used mathematical functions and constants are supported.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• User variables and functions are supported.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "• Yutovo uses units and unit systems and can translate values ​​between them.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,8",
                "type": 2,
                "elements": [
                    {
                        "id": "0,8,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,8,0,0",
                                "type": 4,
                                "elements": "• Automatic recalculation of expressions helps users observe the results of calculations when editing formulas.",
                                "format_id": "edda2549-1299-477f-99b9-471fb41795c7"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
