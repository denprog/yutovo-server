                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "3. Using of information",
                                "format_id": "530682d4-c835-46f5-a7f0-7d69b3e26b6d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "We may use information to verify your account at the website by sending verification email to your registered email address.",
                                "format_id": "530682d4-c835-46f5-a7f0-7d69b3e26b6d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "We may use personal information to respond to user\\'s requests. We may use personal information to improve the services, the website and the desktop application. We may use personal information for ",
                                "format_id": "530682d4-c835-46f5-a7f0-7d69b3e26b6d"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "security purposes to protect users and the website. We may use information as otherwise permitted by law.",
                                "format_id": "530682d4-c835-46f5-a7f0-7d69b3e26b6d"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
