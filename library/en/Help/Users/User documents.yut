            {
                "id": "0,9",
                "type": 2,
                "elements": [
                    {
                        "id": "0,9,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,0,0",
                                "type": 4,
                                "elements": "A document stored on the site opens by clicking on its name in the Documents section. After that, this document can be shared with other people - to do this, you need to give them its address from the ",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ]
                    },
                    {
                        "id": "0,9,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,9,1,0",
                                "type": 4,
                                "elements": "browser line. They will be able to view and edit this document, but they will only be able to save it to their account.",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,10",
                "type": 2,
                "elements": [
                    {
                        "id": "0,10,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,10,0,0",
                                "type": 4,
                                "elements": "Documents from the library can also be saved to their section - after saving, it will appear in the corresponding panel. Thus, examples and various materials from the library can be used as a starting point ",
                                "format_id": "69ad9bd4-428f-4f58-92a3-eb428e821558"
                            }
                        ]
                    },
