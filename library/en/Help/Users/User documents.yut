                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "The user's documents are stored on the site, their list is displayed in the Documents section. Currently, the maximum number of documents for one user is 10, the maximum size of each document is 100 ",
