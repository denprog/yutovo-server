            {
                "id": "0,42",
                "type": 2,
                "elements": [
                    {
                        "id": "0,42,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,42,0,0",
                                "type": 4,
                                "elements": "This way, you can delete all possible operation symbols in the program.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
