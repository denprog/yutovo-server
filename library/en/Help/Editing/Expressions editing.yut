                        "elements": [
                            {
                                "id": "0,12,0,0",
                                "type": 4,
                                "elements": "Pressing the [End] key will take the cursor to a new position - \"after the last symbol\".",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
