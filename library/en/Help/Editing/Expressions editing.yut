                        "type": 3,
                        "elements": [
                            {
                                "id": "0,58,0,0",
                                "type": 4,
                                "elements": "In the previous example, we will start a new formula under the existing one. To do this, press [Enter] when the cursor is at the end of the formula. Pressing [Enter] with the cursor at the beginning will start a ",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
