                        "type": 3,
                        "elements": [
                            {
                                "id": "0,51,1,0",
                                "type": 4,
                                "elements": "[Shift+Left] until this expression is fully selected, or [Shift+Home] to select the entire line. Then enter the root extraction operation by pressing [Shift+Ctrl+Q].",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
