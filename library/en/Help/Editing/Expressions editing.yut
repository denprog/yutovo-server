                        "elements": [
                            {
                                "id": "0,34,0,0",
                                "type": 4,
                                "elements": "You can delete a previously entered operation. Deleting an operation means deleting only the operation symbol while leaving its parameters. This action is performed by pressing [Del] when the cursor is ",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
