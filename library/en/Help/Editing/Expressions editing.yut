            {
                "id": "0,60",
                "type": 2,
                "elements": [
                    {
                        "id": "0,60,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,0,0",
                                "type": 4,
                                "elements": "So, the cursor is in a new formula, currently represented only by an empty line. Move the cursor to the upper formula and select the exponent operation. To do this, place the cursor (using keys or the ",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
                    {
                        "id": "0,60,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,1,0",
                                "type": 4,
                                "elements": "mouse) before the entire exponent operation and press [Shift+Right]. Then copy the selected expression to the clipboard by pressing [Ctrl+Ins] or the button on the toolbar. Then move the cursor to the ",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
                    {
                        "id": "0,60,2",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,60,2,0",
                                "type": 4,
                                "elements": "lower formula and paste the copied expression there by pressing [Shift+Ins] or the paste button on the toolbar. It turns out:",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
