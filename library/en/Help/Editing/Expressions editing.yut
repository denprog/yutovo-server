                        "type": 3,
                        "elements": [
                            {
                                "id": "0,54,0,0",
                                "type": 4,
                                "elements": "Adding operations using the clipboard",
                                "format_id": "08d9a63b-1219-44cf-941b-f5a3643005f5"
                            }
                        ]
                    }
                ],
                "format_name": "Header 4",
                "format_alignment": 0
            },
            {
                "id": "0,55",
                "type": 2,
                "elements": [
                    {
                        "id": "0,55,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,55,0,0",
                                "type": 4,
                                "elements": "For ease of editing, operations with the clipboard are supported. This allows you to quickly enter similar expressions, copy parts of expressions and paste them into other formulas.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,56",
                "type": 2,
                "elements": [
                    {
                        "id": "0,56,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,56,0,0",
                                "type": 4,
                                "elements": "To work with the clipboard, there are buttons on the panel and hotkeys described in the Clipboard section.",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,57",
                "type": 2,
