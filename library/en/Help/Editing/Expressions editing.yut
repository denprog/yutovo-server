                        "elements": [
                            {
                                "id": "0,30,0,0",
                                "type": 4,
                                "elements": "Characters in a line are deleted simply, as is customary in editors. You need to move the cursor to the desired character and press [Del] if the character is on the right, or [Backspace] if the character is on ",
                                "format_id": "e2346a87-7e1e-4242-a86b-73062467c98c"
                            }
                        ]
                    },
