    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "• A unit can only be used after it has been declared.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "• If a unit is not in the SI system, its system is written in the unit's index when it is defined and used.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "• Unit system as such is not defined explicitly; it is declared when it is first used.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,3",
                "type": 2,
                "elements": [
                    {
                        "id": "0,3,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,3,0,0",
                                "type": 4,
                                "elements": "• A unit can be declared anywhere in the document.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,4",
                "type": 2,
                "elements": [
                    {
                        "id": "0,4,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,4,0,0",
                                "type": 4,
                                "elements": "• If a unit is written without mentioning the system, the SI system is used.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,5",
                "type": 2,
                "elements": [
                    {
                        "id": "0,5,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,5,0,0",
                                "type": 4,
                                "elements": "• In order to perform calculations in a certain system of units, all units used in a given expression must be declared in this system.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,6",
                "type": 2,
                "elements": [
                    {
                        "id": "0,6,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,0,0",
                                "type": 4,
                                "elements": "• If the same unit is defined more than once (redefined), then when it is used in expressions, the sequence rule is used: in a specific expression, the unit value that is first above the given expression is ",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    },
                    {
                        "id": "0,6,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,6,1,0",
                                "type": 4,
                                "elements": "used.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,7",
                "type": 2,
                "elements": [
                    {
                        "id": "0,7,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,7,0,0",
                                "type": 4,
                                "elements": "• Built-in units can also be redefined.",
                                "format_id": "84119e37-ba8d-4353-9a85-e07ff823a117"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            }
        ]
    },
    "caret": {
        "id": "0,0,0,0"
