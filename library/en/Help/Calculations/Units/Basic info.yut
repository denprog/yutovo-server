    "text": {
        "id": "0",
        "type": 1,
        "elements": [
            {
                "id": "0,0",
                "type": 2,
                "elements": [
                    {
                        "id": "0,0,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,0,0",
                                "type": 4,
                                "elements": "Yutovo supports units of numbers and unit systems. There are built-in and user-defined units. A unit is defined by the symbol ",
                                "format_id": "003cf8d8-5209-45fe-a03f-766f27c94c31"
                            },
                            {
                                "id": "0,0,0,1",
                                "type": 34,
                                "elements": [],
                                "image_base64": ""
                            },
                            {
                                "id": "0,0,0,2",
                                "type": 4,
                                "elements": " (the \"~\" key). A unit must be defined before its first use. You can define any ",
                                "format_id": "003cf8d8-5209-45fe-a03f-766f27c94c31"
                            }
                        ]
                    },
                    {
                        "id": "0,0,1",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,0,1,0",
                                "type": 4,
                                "elements": "composite units by assigning names to them. In the future, if units are used in the calculated expression, the result will be presented with the most appropriate unit.",
                                "format_id": "003cf8d8-5209-45fe-a03f-766f27c94c31"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,1",
                "type": 2,
                "elements": [
                    {
                        "id": "0,1,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,1,0,0",
                                "type": 4,
                                "elements": "Units are presented for real, rational and complex numbers. There are no units for integer numbers.",
                                "format_id": "003cf8d8-5209-45fe-a03f-766f27c94c31"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
            },
            {
                "id": "0,2",
                "type": 2,
                "elements": [
                    {
                        "id": "0,2,0",
                        "type": 3,
                        "elements": [
                            {
                                "id": "0,2,0,0",
                                "type": 4,
                                "elements": "Built-in units are defined for the following systems: SI, Russian and non-systemic.",
                                "format_id": "003cf8d8-5209-45fe-a03f-766f27c94c31"
                            }
                        ]
                    }
                ],
                "format_name": "Text body",
                "format_alignment": 0
